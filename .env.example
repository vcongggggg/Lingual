# LinguaFlow Environment Variables Baseline
PORT=4000
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/linguaflow_db?schema=public"
JWT_SECRET="linguaflow_super_secret_jwt_key_2026_production"
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
FRONTEND_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (Optional for local dev simulator, required for production)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

