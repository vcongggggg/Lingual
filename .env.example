# ==========================================
# LinguaFlow Environment Configuration
# ==========================================

# 1. Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=linguaflow_db
DATABASE_URL="postgresql://postgres:your_secure_postgres_password_here@localhost:5432/linguaflow_db?schema=public"

# 2. Authentication & Security
# Generate a cryptographically secure random 64-hex-character secret for production
JWT_SECRET=your_super_secret_jwt_key_minimum_64_hex_characters_here

# 3. Server Configuration (API)
PORT=4000
NODE_ENV=production

# 4. CORS & Origins Configuration
# FRONTEND_URL defines the primary web client origin (defaults to http://localhost:3000)
FRONTEND_URL=http://localhost:3000
# ALLOWED_ORIGINS (optional, comma-separated list of additional allowed origins for CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 5. Frontend Public Configuration (Web Client)
# IMPORTANT: When deploying to production, NEXT_PUBLIC_API_URL must be set to the public URL of the API
# (e.g., https://api.yourdomain.com/api/v1) and passed via build arguments.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# 6. Google OAuth 2.0 Credentials (OAuth 2.0 Flow)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 7. Seed Admin Configuration (Bắt buộc khi chạy prisma/seed-admin.ts)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=your_secure_super_admin_password_min_8_chars
SUPER_ADMIN_NAME="Lingual Super Admin"

# 8. Seed Default Admin & Dev Accounts Configuration (prisma/seed.ts)
# ADMIN_EMAIL & ADMIN_PASSWORD: Khởi tạo tài khoản ADMIN khi chạy seed.ts (Mật khẩu >= 8 ký tự, Zero Default Password)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_min_8_chars
# ALLOW_DEV_SEED: Cờ opt-in để seed tài khoản dev (editor, reviewer, student). Mặc định false (tắt để chống lộ mật khẩu mẫu).
ALLOW_DEV_SEED=false

