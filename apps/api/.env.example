# LinguaFlow Backend API Environment Variables (Production & Development)

PORT=4000
NODE_ENV=production
DATABASE_URL="postgresql://postgres:password@localhost:5432/linguaflow_db?schema=public"
JWT_SECRET="your_strong_random_jwt_secret_key_here"

# Domain & CORS Configuration
FRONTEND_URL="https://linguaflow.com"
ALLOWED_ORIGINS="https://linguaflow.com,https://app.linguaflow.com,https://linguaflow.vercel.app"

# Google OAuth 2.0 Credentials (OAuth 2.0 Flow)
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Web Push VAPID Keys (Phase 3)
VAPID_PUBLIC_KEY="your_vapid_public_key_from_generate_vapid_keys"
VAPID_PRIVATE_KEY="your_vapid_private_key_from_generate_vapid_keys"
VAPID_SUBJECT="mailto:support@yourdomain.com"
